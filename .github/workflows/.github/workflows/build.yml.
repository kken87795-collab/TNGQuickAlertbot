
name: Build TNGQuickAlert

on:
  workflow_dispatch:
  push:
    paths:
      - 'TNGQuickAlert-project.zip'
      - 'logo.png'
      - '.github/workflows/build.yml'

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Extract project
        run: unzip -q TNGQuickAlert-project.zip

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install Pillow
        run: pip install pillow

      - name: Create app icon
        run: |
          python - <<'PY'
          from PIL import Image
          import os

          logo = Image.open("logo.png").convert("RGBA")

          sizes = {
              "mdpi": 48,
              "hdpi": 72,
              "xhdpi": 96,
              "xxhdpi": 144,
              "xxxhdpi": 192
          }

          for density, size in sizes.items():
              folder = f"TNGQuickAlert/app/src/main/res/mipmap-{density}"
              os.makedirs(folder, exist_ok=True)

              icon = logo.resize(
                  (size, size),
                  Image.Resampling.LANCZOS
              )

              icon.save(f"{folder}/ic_launcher.png")

          print("Logo icons created successfully")
          PY

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Build APK
        run: gradle -p TNGQuickAlert assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: TNGQuickAlert-APK
          path: TNGQuickAlert/app/build/outputs/apk/debug/app-debug.apk
